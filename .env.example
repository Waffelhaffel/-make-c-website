# ──────────────────────────────────────────────────────────────────────────
# Sanity CMS – Umgebungsvariablen
#
# Kopiere diese Datei zu `.env.local` und fülle die Werte aus.
#
# Sanity verwaltet seit 31.07.2026 nur noch die Case Studies; der übrige
# Seiteninhalt liegt hartcodiert in `lib/content/`. Ohne gültige Konfiguration
# bleiben daher `/work` und das Selected-Work-Grid leer (sowie die drei
# Case-Kacheln je Leistungsseite) — alle anderen Seiten rendern vollständig.
#
# WICHTIG für Vercel: Die NEXT_PUBLIC_*-Variablen werden zur BUILD-ZEIT
# eingebettet. Sie müssen daher im Vercel-Projekt unter
#   Settings → Environment Variables
# für ALLE Environments (Production, Preview, Development) gesetzt sein.
# ──────────────────────────────────────────────────────────────────────────

# ── Erforderlich (öffentlich, im Client sichtbar) ──────────────────────────

# Projekt-ID aus dem Sanity-Dashboard (z. B. "ppeo9yox").
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset-Name (typischerweise "production").
NEXT_PUBLIC_SANITY_DATASET=production

# ── Optional (öffentlich) ──────────────────────────────────────────────────

# API-Version (Datum). Wenn leer, wird "2024-10-01" verwendet.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ── Optional (server-only, NIEMALS mit NEXT_PUBLIC_ prefixen) ───────────────

# Read-Token: nur nötig bei privatem Dataset oder Draft-Vorschau.
# Bei öffentlichem Dataset leer lassen.
# Alternativ wird auch SANITY_API_TOKEN als Read-Token akzeptiert.
SANITY_API_READ_TOKEN=

# Write-Token: ausschließlich für die lokalen Case-Seed-Skripte
# (scripts/seed-case-*.ts, seed-placeholder-cases.ts). Wird im Production-Build
# NICHT benötigt.
SANITY_API_WRITE_TOKEN=

# Generischer Token (Fallback für Read und Write, falls nur einer gepflegt wird).
# SANITY_API_TOKEN=

# ── SEO (öffentlich, build-time inlined → nach Änderung neu deployen!) ──────

# Basis-URL für canonical-Links, OpenGraph, sitemap.xml, robots.txt, JSON-LD
# und llms.txt. Ohne Wert wird "https://make-c-website.vercel.app" verwendet.
# Vor dem Go-Live auf die echte Domain setzen.
NEXT_PUBLIC_SITE_URL=

# Indexierung freischalten. Nur der exakte Wert "true" aktiviert sie.
# Ohne die Variable liefert die Seite `noindex, nofollow` und
# robots.txt = "Disallow: /" — der gewollte Zustand vor dem Go-Live.
NEXT_PUBLIC_SEO_INDEX=
